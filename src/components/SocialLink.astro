---
import type { SocialLink } from "../data/social-links";

interface Props extends SocialLink {}

const { label, handle, href } = Astro.props;
---

<a
  class="social-link"
  href={href}
  target="_blank"
  rel="noreferrer noopener me"
  aria-label={`${label} — ${handle}`}
>
  <span class="social-link__label">{label}</span>
  <span class="social-link__handle" aria-hidden="true">@{handle}</span>
</a>

<style>
  .social-link {
    display: inline-flex;
    flex-direction: column;
    gap: 0.15em;
    color: inherit;
    text-decoration: none;
    padding-block: 0.15em;
  }

  .social-link__label {
    position: relative;
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.2rem);
    font-weight: 600;
  }

  .social-link__label::after {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-inline-end: 0;
    bottom: -0.12em;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 320ms var(--ease, ease);
  }

  .social-link:hover .social-link__label::after,
  .social-link:focus-visible .social-link__label::after {
    transform: scaleX(1);
  }

  .social-link__handle {
    font-size: clamp(0.8rem, 0.72rem + 0.3vw, 0.9rem);
    font-weight: 400;
    color: var(--color-muted);
    transition: color 320ms var(--ease, ease);
  }

  .social-link:hover .social-link__handle,
  .social-link:focus-visible .social-link__handle {
    color: var(--color-accent);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .social-link__label::after,
    .social-link__handle {
      transition: none;
    }
  }
</style>
